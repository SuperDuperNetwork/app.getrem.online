# =============================================================================
# REM Network Platform - Environment Variables
# =============================================================================
# Copy this to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication (https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk webhook signing secret (Clerk Dashboard → Webhooks → Signing Secret)
# Webhook URL: https://app.getrem.online/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# Clerk redirect routes (no need to change these)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# Stripe Billing (https://dashboard.stripe.com)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE

# -----------------------------------------------------------------------------
# Backend API (coordinator on VPS)
# -----------------------------------------------------------------------------
# Server-side only — used by Next.js rewrites and webhook forwarding.
# This is NOT exposed to the browser.
BACKEND_URL=https://getrem.online
