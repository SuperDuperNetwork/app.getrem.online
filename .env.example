# =============================================================================
# REM Network Platform - Environment Variables
# =============================================================================
# On Vercel: set these in Project Settings → Environment Variables.
# For local dev: copy this file to .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication (https://dashboard.clerk.com/last-active?path=api-keys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c3VwZXItc2hlcGhlcmQtNjQuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Clerk webhook signing secret (Clerk Dashboard → Webhooks → Signing Secret)
# Webhook URL: https://app.getrem.online/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Clerk redirect routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# Stripe Billing (https://dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51RWE5yIDHxKV2bgFB69UQwn8B0TtHhC58DMpnuVLiWZB3TPa8sQYExeGZGchVKTEtnLGkADNQ0ISXvgoXV9yo8Xl005cmPWLPh
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# Stripe webhook signing secret (Stripe Dashboard → Developers → Webhooks → Signing secret)
# Webhook URL: https://app.getrem.online/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# Backend API (coordinator on VPS)
# -----------------------------------------------------------------------------
# Server-side only — used by Next.js rewrites and webhook forwarding.
BACKEND_URL=https://getrem.online
